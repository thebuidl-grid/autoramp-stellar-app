// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Enables passing a custom `adapter` (e.g. PGlite, for tests) into
  // `new PrismaClient({ adapter })`. Purely additive — production code
  // keeps using `new PrismaClient()` with DATABASE_URL, unaffected.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password      String? // Optional password (for email-only auth)
  phoneNumber   String?  @map("phone_number")
  walletAddress String?  @map("wallet_address")
  role          UserRole @default(USER)
  businessName  String?  @map("business_name")
  websiteUrl    String?  @map("website_url")
  contactName   String?  @map("contact_name")
  isApiAccessApproved Boolean @default(false) @map("is_api_access_approved")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  onrampTransactions  OnrampTransaction[]
  offrampTransactions OfframpTransaction[]
  swapTransactions    SwapTransaction[]
  transactionLogs     TransactionLog[]
  apiKeys             ApiKey[]
  apiRequestLogs      ApiRequestLog[]

  @@index([email])
  @@map("users")
}

// Admin model for admin authentication
model Admin {
  id        String  @id @default(uuid()) @db.Uuid
  email     String  @unique
  password  String // Hashed password
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  isActive  Boolean @default(true) @map("is_active")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@index([email])
  @@map("admins")
}

// OTP model for email verification
model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String // 6-digit OTP code
  purpose   String   @default("SIGNUP") // SIGNUP, RESET_PASSWORD, etc.
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamp

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([email])
  @@index([code])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("otps")
}

// Onramp Transactions Table (NGN to CNGN)
model OnrampTransaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Transaction Details
  reference   String   @unique
  amount      Decimal  @db.Decimal(20, 2)
  currency    String   @default("NGN")
  tokenAmount Decimal? @map("token_amount") @db.Decimal(20, 8) // CNGN amount to receive
  tokenType   String   @default("CNGN") @map("token_type") // CNGN, USDC, USDT, etc.

  // Status Tracking
  status             TransactionStatus @default(PENDING)
  flintTransactionId String?           @map("flint_transaction_id")

  // Destination (User's wallet)
  destinationAddress String @map("destination_address")

  // Cross-chain delivery: when set to something other than the corridor's
  // own stablecoin on Stellar (payoutChain default / payoutTokenCode null),
  // completeOnrampTransaction routes through CustodialDeliveryService.deliverOnramp
  // instead of a plain sendFromDistribution — see that service for the
  // swap/bridge orchestration. Null payoutTokenCode + default payoutChain
  // is today's only behavior, unchanged.
  payoutChain     String  @default("stellar") @map("payout_chain")
  payoutTokenCode String? @map("payout_token_code")

  // Flint API Response Data
  network        String? // base, bsc, ethereum, polygon, etc.
  notifyUrl      String? @map("notify_url") @db.Text
  depositAccount Json?   @map("deposit_account") @db.JsonB // stores bank details from Flint response

  // Metadata
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent") @db.Text
  metadata  Json?   @db.JsonB

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp
  completedAt DateTime? @map("completed_at") @db.Timestamp

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([createdAt])
  @@map("onramp_transactions")
}

// Offramp Transactions Table (CNGN to NGN)
model OfframpTransaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Transaction Details
  reference  String   @unique
  amount     Decimal  @db.Decimal(20, 2) // Token amount
  fiatAmount Decimal? @map("fiat_amount") @db.Decimal(20, 2) // NGN amount to receive
  currency   String   @default("NGN")
  tokenType  String   @default("CNGN") @map("token_type") // CNGN, USDC, USDT, etc.

  // Status Tracking
  status             TransactionStatus @default(PENDING)
  flintTransactionId String?           @map("flint_transaction_id")
  swapId             String?           @unique @map("swap_id") @db.Uuid // Reference to swap transaction (one-to-one relation)

  // Stellar deposits land on a shared AutoRamp-controlled account,
  // disambiguated by this memo (unlike Base's unique-address-per-tx model).
  memo String? @db.VarChar(28)

  // Destination (Bank Account)
  bankCode      String  @map("bank_code")
  accountNumber String  @map("account_number")
  accountName   String? @map("account_name")
  bankName      String? @map("bank_name")

  // Flint API Response Data
  network   String? // base, bsc, ethereum, polygon, etc.
  notifyUrl String? @map("notify_url") @db.Text

  // Metadata
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent") @db.Text
  metadata  Json?   @db.JsonB

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp
  completedAt DateTime? @map("completed_at") @db.Timestamp

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapTransaction SwapTransaction? @relation("SwapToOfframp", fields: [swapId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([accountNumber])
  @@index([createdAt])
  @@map("offramp_transactions")
}

// Swap Transactions Table (Token to Token swaps)
model SwapTransaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Transaction Details
  reference String @unique

  // From Token
  fromTokenType String  @map("from_token_type") // CNGN, USDC, USDT, etc.
  fromAmount    Decimal @map("from_amount") @db.Decimal(20, 8)
  fromNetwork   String? @map("from_network") // base, bsc, ethereum, polygon, etc.

  // To Token
  toTokenType String  @map("to_token_type") // CNGN, USDC, USDT, etc.
  toAmount    Decimal @map("to_amount") @db.Decimal(20, 8)
  toNetwork   String? @map("to_network") // base, bsc, ethereum, polygon, etc.

  // Exchange Rate
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(20, 8)

  // Wallet Addresses
  sourceAddress      String @map("source_address")
  destinationAddress String @map("destination_address")

  // Status Tracking
  status          TransactionStatus @default(PENDING)
  transactionHash String?           @map("transaction_hash") // blockchain transaction hash

  // Memo used when destination is a shared AutoRamp-controlled account
  // (e.g. swap output feeding directly into an offramp collection).
  memo String? @db.VarChar(28)

  // Fees
  feeAmount   Decimal? @map("fee_amount") @db.Decimal(20, 8)
  feeCurrency String?  @map("fee_currency")

  // Metadata
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent") @db.Text
  metadata  Json?   @db.JsonB

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp
  completedAt DateTime? @map("completed_at") @db.Timestamp

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  offrampTransaction OfframpTransaction? @relation("SwapToOfframp")

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([fromTokenType])
  @@index([toTokenType])
  @@index([createdAt])
  @@map("swap_transactions")
}

// Webhook Events Table (for onramp, offramp, and swap)
model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType @map("transaction_type") // 'onramp', 'offramp', 'swap'
  transactionId   String          @map("transaction_id") @db.Uuid // references onramp, offramp, or swap transaction
  reference       String

  // Event Details
  eventType String? @map("event_type") // status_update, completion, failure, etc.
  status    String?

  // Raw Payload
  payload Json @db.JsonB

  // Processing
  processed    Boolean   @default(false)
  processedAt  DateTime? @map("processed_at") @db.Timestamp
  errorMessage String?   @map("error_message") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  // Note: Relations to specific transaction types are handled via transactionId and transactionType
  // No direct foreign key constraints due to polymorphic relationship

  @@index([transactionId])
  @@index([reference])
  @@index([transactionType])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_events")
}

// Transaction Logs Table (for audit trail)
model TransactionLog {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType @map("transaction_type") // 'onramp', 'offramp', 'swap'
  transactionId   String          @map("transaction_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid // Optional user reference for easier querying

  // Log Details
  action      String // created, status_changed, completed, failed, etc.
  oldStatus   String? @map("old_status")
  newStatus   String? @map("new_status")
  description String? @db.Text

  // Additional Data
  metadata Json? @db.JsonB

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionType])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("transaction_logs")
}

// Supported Tokens Table (for tracking available tokens)
model SupportedToken {
  id           String   @id @default(uuid()) @db.Uuid
  tokenSymbol  String   @unique @map("token_symbol") // CNGN, USDC, USDT, etc.
  tokenName    String   @map("token_name") // Canza Finance NGN, USD Coin, etc.
  tokenAddress String?  @map("token_address") // smart contract address
  network      String // base, bsc, ethereum, polygon, etc.
  decimals     Int      @default(18)
  isActive     Boolean  @default(true) @map("is_active")
  logoUrl      String?  @map("logo_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@index([tokenSymbol])
  @@index([network])
  @@index([isActive])
  @@map("supported_tokens")
}

// API Keys Table (for public API access)
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  key        String    @unique // The actual API key (hashed)
  keyPrefix  String    @map("key_prefix") // First 8 chars for display (e.g., "sk_live_")
  name       String? // Optional name for the API key
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp
  expiresAt DateTime? @map("expires_at") @db.Timestamp

  // Additional Data
  metadata Json? @db.JsonB

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiRequestLogs ApiRequestLog[]

  @@index([userId])
  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

// API Request Logs Table (for tracking public API usage)
model ApiRequestLog {
  id       String  @id @default(uuid()) @db.Uuid
  apiKeyId String? @map("api_key_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  // Request Details
  method     String // GET, POST, etc.
  path       String // Request path
  statusCode Int     @map("status_code") // HTTP status code
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent") @db.Text

  // Request/Response
  requestBody  Json?   @map("request_body") @db.JsonB
  responseBody Json?   @map("response_body") @db.JsonB
  errorMessage String? @map("error_message") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relations
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("api_request_logs")
}

// Corridor: registry of which country/fiat pairs AutoRamp can actually serve,
// and how — which local stablecoin represents that fiat on Stellar, which
// RampProcessor provider handles the bank rail, and whether AutoRamp is
// licensed to operate there yet. Drives corridor-aware routing instead of
// the single hardcoded NGN/CNGN path.
model Corridor {
  id                     String  @id @default(uuid()) @db.Uuid
  countryCode            String  @map("country_code") @db.VarChar(2)
  fiatCurrency           String  @map("fiat_currency") @db.VarChar(3)
  stablecoinCode         String  @map("stablecoin_code") @db.VarChar(12)
  stablecoinIssuer       String  @map("stablecoin_issuer")
  rampProcessorProvider  String  @map("ramp_processor_provider")
  licensingStatus        LicensingStatus @default(UNLICENSED) @map("licensing_status")
  isActive               Boolean @default(true) @map("is_active")
  notes                  String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@unique([countryCode, fiatCurrency])
  @@index([isActive])
  @@map("corridors")
}

// Chain: registry of blockchains AutoRamp's USDC bridge infra can move
// value between — both as a CCTP source and destination (Phase 2: any
// registered chain to any registered chain, not just inbound-to-Stellar).
// The registry itself is chain-agnostic so adding a new chain later is a
// row, not a code change — same pattern as Corridor.
model Chain {
  id                        String    @id @default(uuid()) @db.Uuid
  name                      String    @unique @db.VarChar(32) // 'stellar', 'base', 'ethereum'
  chainType                 ChainType @map("chain_type")
  cctpDomain                Int       @unique @map("cctp_domain") // Circle's CCTP domain id (Stellar = 27)
  usdcAddress               String    @map("usdc_address") // ERC-20 address (EVM) or Stellar asset issuer
  tokenMessengerAddress     String?   @map("token_messenger_address")
  messageTransmitterAddress String?   @map("message_transmitter_address")
  cctpForwarderAddress      String?   @map("cctp_forwarder_address") // Stellar only
  isActive                  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  chainTokens ChainToken[]

  @@index([isActive])
  @@map("chains")
}

enum ChainType {
  EVM
  STELLAR
}

// Bridgeable-in stablecoins per EVM chain, beyond the chain's own USDC
// (Chain.usdcAddress) — a chain can hold several (USDC, USDT, DAI, ...).
// createTransferIntent swaps sourceTokenCode -> USDC via ZeroXSwapQuoteService
// before the existing CCTP approve+burn when this isn't plain USDC. Stellar
// doesn't need this table — its non-USDC "source token" case (a corridor
// stablecoin or XLM) is resolved via the corridor registry / hardcoded
// native asset instead, same as SwapService.resolveAsset.
model ChainToken {
  id        String  @id @default(uuid()) @db.Uuid
  chainId   String  @map("chain_id") @db.Uuid
  chain     Chain   @relation(fields: [chainId], references: [id])
  tokenCode String  @map("token_code") // 'USDC', 'USDT', 'DAI'
  address   String // ERC-20 address on this chain
  decimals  Int     @default(6)
  isActive  Boolean @default(true) @map("is_active")
  // This token's own natural fiat currency (ISO 4217) — 'EUR' for EURC,
  // 'BRL' for BRZ, 'NGN' for CNGNX, etc. Drives Buy/Sell's auto-populated
  // fiat side once a named regional stablecoin is picked; a corridor for
  // this currency may or may not exist yet (Buy/Sell disable submission
  // when it doesn't, rather than hiding the token — see CorridorService).
  // Generic 'USDC' isn't a ChainToken row at all (see the model comment
  // above), so it has no fixed fiatCurrency here — the frontend treats it
  // like XLM/BRIDGE_USDC, a hub asset with a freely user-chosen payout.
  fiatCurrency String @map("fiat_currency") @db.VarChar(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@unique([chainId, tokenCode])
  @@map("chain_tokens")
}

// BridgeTransfer: tracks one CCTP burn->attest->mint cycle, in any
// registered-chain-to-registered-chain direction. Created as PENDING_BURN
// when a caller registers transfer intent; moves to BURNED once the
// source-chain burn tx is known (self-reported for a Stellar source via
// POST /bridge/transfers/:reference/register-burn, or auto-detected by
// EvmDepositWatcherService for an EVM source), then ATTESTED/COMPLETED as
// BridgeRelayerService (a scheduled watcher, same @Interval pattern as
// OfframpDepositWatcherService) polls Circle's attestation service and
// completes the destination-chain mint.
model BridgeTransfer {
  id                 String   @id @default(uuid()) @db.Uuid
  reference          String   @unique
  userId             String?  @map("user_id") @db.Uuid
  sourceChain        String   @map("source_chain") // Chain.name
  destinationChain   String   @default("stellar") @map("destination_chain") // Chain.name
  destinationAddress String   @map("destination_address") // Stellar strkey or EVM 0x address, per destinationChain
  expectedAmount     Decimal? @map("expected_amount") @db.Decimal(20, 7)

  // EVM-source custodial collection leg — historical only. The EVM-source
  // burn is now self-custodial too (the user's own connected wallet signs
  // approve + depositForBurnWithHook directly, same as the Stellar leg), so
  // these are permanently unpopulated for new rows; kept nullable for old data.
  collectionAddress            String? @map("collection_address")
  collectionAddressEncryptedKey String? @map("collection_address_encrypted_key") @db.Text
  gasFundingTxHash              String? @map("gas_funding_tx_hash")

  // Multi-stablecoin bridge-in: when set and not USDC, the source-chain leg
  // swaps this token to USDC (via ZeroXSwapQuoteService, on an EVM source)
  // before the existing approve+burn — see createTransferIntent. Null/USDC
  // means "skip the swap step," today's behavior. sourceSwapMinUsdc is the
  // slippage-floor-guaranteed USDC amount the swap quote promised; that
  // (not the higher point-estimate) is what actually gets burned, so the
  // burn amount can never exceed what the wallet is guaranteed to hold
  // post-swap — any better-than-quoted execution just leaves USDC dust.
  sourceTokenCode  String?  @map("source_token_code")
  sourceSwapQuote  Decimal? @map("source_swap_quote") @db.Decimal(30, 6)
  sourceSwapMinUsdc Decimal? @map("source_swap_min_usdc") @db.Decimal(20, 6)

  // Swap tab: when set, the destination-chain mint is followed by minting
  // this corridor stablecoin to the user instead of leaving raw USDC with
  // them (see StablestackService/StellarService.sendFromDistribution and
  // BridgeService.completeIfAttested). quotedPayoutAmount/minPayoutAmount
  // are captured from a live quote at intent-creation time (not completion
  // time, which can be minutes later post-attestation) — completeIfAttested
  // refuses to pay out below minPayoutAmount, moving to PAYOUT_HELD instead
  // of silently shortchanging the user if the rate moved against them.
  payoutStablecoinCode String?  @map("payout_stablecoin_code")
  payoutSlippage       Decimal  @default(0.05) @map("payout_slippage") @db.Decimal(5, 4)
  quotedPayoutAmount   Decimal? @map("quoted_payout_amount") @db.Decimal(20, 7)
  minPayoutAmount      Decimal? @map("min_payout_amount") @db.Decimal(20, 7)
  payoutAmount         Decimal? @map("payout_amount") @db.Decimal(20, 7)
  payoutTxHash         String?  @map("payout_tx_hash")

  // EVM destination follow-up swap: when set, the mint (which always lands
  // directly in destinationAddress, self-custodially — see
  // buildDestinationEncoding) can be followed by a self-custodial swap into
  // this ChainToken via POST /bridge/transfers/:reference/build-destination-swap,
  // signed by the user's own connected wallet on destinationChain. Mutually
  // exclusive with payoutStablecoinCode (that one is the Stellar-only,
  // custodial equivalent).
  payoutTokenCode String? @map("payout_token_code")

  // Sell-any-chain fiat terminal: when set, a completed mint (redirected to
  // AutoRamp's own distribution account, same trick payoutStablecoinCode
  // uses) triggers a fiat payout instead of a stablecoin one — see
  // BridgeService.deliverOfframp. Mutually exclusive with
  // payoutStablecoinCode/payoutTokenCode.
  payoutFiat          Boolean @default(false) @map("payout_fiat")
  payoutBankCode      String? @map("payout_bank_code")
  payoutAccountNumber String? @map("payout_account_number")
  payoutFiatCurrency  String? @map("payout_fiat_currency")

  burnTxHash     String? @unique @map("burn_tx_hash")
  status         String  @default("PENDING_BURN") // PENDING_BURN, BURNED, ATTESTED, MINTED, COMPLETED, FAILED, PAYOUT_HELD (rate moved beyond payoutSlippage at completion; needs manual payout)
  rawMessage     String? @map("raw_message") @db.Text
  rawAttestation String? @map("raw_attestation") @db.Text
  mintTxHash     String? @map("mint_tx_hash")
  errorMessage   String? @map("error_message") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp
  completedAt DateTime? @map("completed_at") @db.Timestamp

  @@index([status])
  @@map("bridge_transfers")
}

// Enums
enum LicensingStatus {
  UNLICENSED
  PENDING
  LICENSED
  PARTNERED // operating under a licensed partner/anchor, not directly licensed
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  onramp
  offramp
  swap
  bridge
}
