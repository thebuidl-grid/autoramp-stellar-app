generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  password            String?
  phoneNumber         String?              @map("phone_number")
  walletAddress       String?              @map("wallet_address")
  role                UserRole             @default(USER)
  isMerchant          Boolean              @default(false) @map("is_merchant")
  businessName        String?              @map("business_name")
  websiteUrl          String?              @map("website_url")
  contactName         String?              @map("contact_name")
  isApiAccessApproved Boolean              @default(false) @map("is_api_access_approved")
  isOTCEnabled        Boolean              @default(false) @map("is_otc_enabled")
  suspended           Boolean              @default(false)
  suspendedAt         DateTime?            @map("suspended_at") @db.Timestamp(6)
  bitnobCustomerId  String?              @map("bitnob_customer_id")
  bitnobVirtualAccount Json?               @map("bitnob_virtual_account")
  lastActiveAt        DateTime?            @map("last_active_at") @db.Timestamp(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  merchant            Merchant?
  onrampTransactions  OnrampTransaction[]
  offrampTransactions OfframpTransaction[]
  swapTransactions    SwapTransaction[]
  transactionLogs     TransactionLog[]
  wallets             UserWallet[]
  bankAccounts        UserBankAccount[]
  virtualAccounts     VirtualAccount[]
  bridgeTransactions   BridgeTransaction[]
  otcUser             OtcUser?
  otcTransactions     OtcTransaction[]

  @@index([email])
  @@index([isMerchant])
  @@index([lastActiveAt])
  @@map("users")
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([email])
  @@map("admins")
}

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  phoneNumber String? @map("phone_number")
  /// What the person does: crypto_native | freelancer | cross_border | fintech (see waitlist.constants.ts)
  userType  String?  @map("user_type")
  /// ISO 3166-1 alpha-2 country picked in the phone-number selector
  phoneCountry String? @map("phone_country")
  /// ISO 3166-1 alpha-2 country the request came from (edge header; analytics only, not verified)
  country   String?
  /// Hostname of the page that sent the visitor (null = direct / unknown)
  referrer  String?
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt])
  @@map("waitlist_entries")
}

model Otp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String
  purpose   String   @default("SIGNUP")
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([email])
  @@index([code])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("otps")
}

model OnrampTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  reference          String            @unique
  amount             Decimal           @db.Decimal(20, 2)
  currency           String            @default("NGN")
  tokenAmount        Decimal?          @map("token_amount") @db.Decimal(20, 8)
  tokenType          String            @default("CNGN") @map("token_type")
  status             TransactionStatus @default(PENDING)
  flintTransactionId String?           @map("flint_transaction_id")
  destinationAddress String            @map("destination_address")
  network            String?
  notifyUrl          String?           @map("notify_url")
  depositAccount     Json?             @map("deposit_account")
  safehavenAccount   Json?             @map("safehaven_account")
  pulseMfbAccount    Json?             @map("pulse_mfb_account")
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  transactionLocation String?          @map("transaction_location")
  webhookPayload     Json?             @map("webhook_payload")
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamp(6)
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which chain network the website was on (its mainnet/testnet toggle) when this was created. Null = not said (older rows, webhooks).
  chainNetwork String? @map("chain_network")

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([createdAt])
  @@map("onramp_transactions")
}

model OfframpTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  reference          String            @unique
  amount             Decimal           @db.Decimal(20, 2)
  fiatAmount         Decimal?          @map("fiat_amount") @db.Decimal(20, 2)
  currency           String            @default("NGN")
  tokenType          String            @default("CNGN") @map("token_type")
  status             TransactionStatus @default(PENDING)
  flintTransactionId String?           @map("flint_transaction_id")
  // Provider-specific details (Bitnob) — one row, null for legacy Flint orders
  swapId             String?           @unique @map("swap_id") @db.Uuid
  bankCode           String            @map("bank_code")
  accountNumber      String            @map("account_number")
  accountName        String?           @map("account_name")
  bankName           String?           @map("bank_name")
  network            String?
  notifyUrl          String?           @map("notify_url")
  safehavenAccount   Json?             @map("safehaven_account")
  pulseMfbAccount    Json?             @map("pulse_mfb_account")
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamp(6)
  /// NGN actually paid out (expected payout is fiatAmount). Null until a payout settles.
  settledFiatAmount  Decimal?          @map("settled_fiat_amount") @db.Decimal(20, 2)
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapTransaction    SwapTransaction?  @relation("SwapToOfframp", fields: [swapId], references: [id], onDelete: SetNull)
  reconciliation     OfframpReconciliation?
  reversal           OfframpReversal?
  events             OfframpEvent[]

  /// Which chain network the website was on (its mainnet/testnet toggle) when this was created. Null = not said (older rows, webhooks).
  chainNetwork String? @map("chain_network")

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([accountNumber])
  @@index([createdAt])
  @@map("offramp_transactions")
}

model SwapTransaction {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  reference          String              @unique
  fromTokenType      String              @map("from_token_type")
  fromAmount         Decimal             @map("from_amount") @db.Decimal(20, 8)
  fromNetwork        String?             @map("from_network")
  toTokenType        String              @map("to_token_type")
  toAmount           Decimal             @map("to_amount") @db.Decimal(20, 8)
  toNetwork          String?             @map("to_network")
  exchangeRate       Decimal             @map("exchange_rate") @db.Decimal(20, 8)
  sourceAddress      String              @map("source_address")
  destinationAddress String              @map("destination_address")
  status             TransactionStatus   @default(PENDING)
  transactionHash    String?             @map("transaction_hash")
  feeAmount          Decimal?            @map("fee_amount") @db.Decimal(20, 8)
  feeCurrency        String?             @map("fee_currency")
  ipAddress          String?             @map("ip_address")
  userAgent          String?             @map("user_agent")
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamp(6)
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  offrampTransaction OfframpTransaction? @relation("SwapToOfframp")

  /// Which chain network the website was on (its mainnet/testnet toggle) when this was created. Null = not said (older rows, webhooks).
  chainNetwork String? @map("chain_network")

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([fromTokenType])
  @@index([toTokenType])
  @@index([createdAt])
  @@map("swap_transactions")
}

model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType @map("transaction_type")
  transactionId   String          @map("transaction_id") @db.Uuid
  reference       String
  eventType       String?         @map("event_type")
  status          String?
  provider        String?
  payload         Json
  processed       Boolean         @default(false)
  processedAt     DateTime?       @map("processed_at") @db.Timestamp(6)
  errorMessage    String?         @map("error_message")
  /// The provider leg (transaction_providers.id) this event belongs to.
  legId           String?         @map("leg_id") @db.Uuid
  /// The raw receipt (inbound_webhooks.id) this processed event came from.
  inboundWebhookId String?        @map("inbound_webhook_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([transactionId])
  @@index([legId])
  @@index([inboundWebhookId])
  @@index([reference])
  @@index([transactionType])
  @@index([provider])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_events")
}

model TransactionLog {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType @map("transaction_type")
  transactionId   String          @map("transaction_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  action          String
  oldStatus       String?         @map("old_status")
  newStatus       String?         @map("new_status")
  description     String?
  metadata        Json?
  /// Which parent table `transactionId` points into: transactions (USER) or merchant_transactions (MERCHANT).
  scope           LedgerScope     @default(USER)
  /// The provider leg (transaction_providers.id) this step belongs to, if any.
  legId           String?         @map("leg_id") @db.Uuid
  provider        ProviderName?
  /// Machine-readable step name, e.g. "burn_submitted", "attestation_ready", "payout_initiated".
  step            String?
  outcome         LogOutcome?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([legId])
  @@index([transactionType])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("transaction_logs")
}

model TransactionFee {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  transactionType String @map("transaction_type")
  feeAmount     Decimal  @map("fee_amount") @db.Decimal(20, 2)
  feeType       String   @map("fee_type") // provider_fee, vat, stamp_duty, platform_fee
  feeCurrency   String   @map("fee_currency") @default("NGN")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([transactionId])
  @@index([transactionType])
  @@index([feeType])
  @@index([createdAt])
  @@map("transaction_fees")
}

model Merchant {
  id               String                       @id @default(uuid()) @db.Uuid
  userId           String                       @unique @map("user_id") @db.Uuid
  name             String                       @unique
  natureOfBusiness String                       @unique @map("nature_of_business")
  description      String?
  websiteUrl       String                       @unique @map("website_url")
  addressLine1     String?                      @map("address_line1")
  addressLine2     String?                      @map("address_line2")
  city             String?
  state            String?
  country          String                       @default("Nigeria")
  postalCode       String?                      @map("postal_code")
  status           MerchantStatus               @default(PENDING)
  verifiedAt       DateTime?                    @map("verified_at") @db.Timestamp(6)
  rejectionReason  String?                      @map("rejection_reason")
  bitnobCustomerId  String?                     @map("bitnob_customer_id")
  bitnobVirtualAccount Json?                     @map("bitnob_virtual_account")
  metadata         Json?
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamp(6)
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentations   MerchantDocumentation[]
  directors        MerchantDirector[]
  shareholders     MerchantShareholder[]
  onramps          MerchantOnrampTransaction[]
  offramps         MerchantOfframpTransaction[]
  swaps            MerchantSwapTransaction[]
  bankTransfers    MerchantBankTransfer[]
  apiKeys          MerchantApiKey[]
  apiRequestLogs   MerchantApiRequestLog[]
  bridgeTransactions   BridgeTransaction[]
  vasTransactions     VasTransaction[]
  bankAccount      MerchantBankAccount?
  settlementAccount MerchantSettlementAccount?
  subAccounts      MerchantSubAccount[]
  virtualAccounts  VirtualAccount[]
  webhooks         MerchantWebhook[]

  @@index([name])
  @@index([websiteUrl])
  @@index([status])
  @@map("merchants")
}

model MerchantWebhook {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  url         String
  secret      String
  active      Boolean  @default(true)
  label       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([active])
  @@map("merchant_webhooks")
}

model MerchantDocumentation {
  id                      String   @id @default(uuid()) @db.Uuid
  merchantId              String   @map("merchant_id") @db.Uuid
  cacCertificate          String?  @map("cac_certificate")
  cacEStatus              String?  @map("cac_e_status")
  memart                  String?
  memorandum              String?
  proofOfAddress          String?  @map("proof_of_address")
  capitalSource           String?  @map("capital_source")
  tradingName             String?  @map("trading_name")
  taxIdentificationNumber String?  @map("tax_identification_number")
  proofOfFunds            String?  @map("proof_of_funds")
  metadata                Json?
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  merchant                Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([tradingName])
  @@index([taxIdentificationNumber])
  @@map("merchant_documentations")
}

model MerchantDirector {
  id             String   @id @default(uuid()) @db.Uuid
  merchantId     String   @map("merchant_id") @db.Uuid
  firstName      String?
  lastName       String?
  nationality    String?
  bvn            String?
  proofOfAddress String?  @map("proof_of_address")
  idType         String?  @map("id_type")
  idUrl          String?  @map("id_url")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([bvn])
  @@index([nationality])
  @@map("merchant_directors")
}

model MerchantShareholder {
  id             String   @id @default(uuid()) @db.Uuid
  merchantId     String   @map("merchant_id") @db.Uuid
  firstName      String?
  lastName       String?
  nationality    String?
  bvn            String?
  proofOfAddress String?  @map("proof_of_address")
  idType         String?  @map("id_type")
  idUrl          String?  @map("id_url")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([bvn])
  @@index([nationality])
  @@map("merchant_shareholders")
}

model MerchantOnrampTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  merchantId         String            @map("merchant_id") @db.Uuid
  reference          String            @unique
  amount             Decimal           @db.Decimal(20, 2)
  currency           String            @default("NGN")
  tokenAmount        Decimal?          @map("token_amount") @db.Decimal(20, 8)
  tokenType          String            @default("CNGN") @map("token_type")
  status             TransactionStatus @default(PENDING)
  paymentReference   String?           @map("payment_reference")
  destinationAddress String            @map("destination_address")
  network            String?
  notifyUrl          String?           @map("notify_url")
  depositAccount     Json?             @map("deposit_account")
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  transactionLocation String?          @map("transaction_location")
  webhookPayload     Json?             @map("webhook_payload")
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamp(6)
  merchant           Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// Which chain network the website was on (its mainnet/testnet toggle) when this was created. Null = not said (older rows, webhooks).
  chainNetwork String? @map("chain_network")

  @@index([merchantId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([createdAt])
  @@map("merchant_onramp_transactions")
}

model MerchantOfframpTransaction {
  id               String            @id @default(uuid()) @db.Uuid
  merchantId       String            @map("merchant_id") @db.Uuid
  reference        String            @unique
  amount           Decimal           @db.Decimal(20, 2)
  fiatAmount       Decimal?          @map("fiat_amount") @db.Decimal(20, 2)
  currency         String            @default("NGN")
  tokenType        String            @default("CNGN") @map("token_type")
  status           TransactionStatus @default(PENDING)
  paymentReference String?           @map("payment_reference")
  // Provider-specific details (Bitnob) — one row, null for legacy Flint orders
  bankCode         String            @map("bank_code")
  accountNumber    String            @map("account_number")
  accountName      String?           @map("account_name")
  bankName         String?           @map("bank_name")
  network          String?
  notifyUrl        String?           @map("notify_url")
  ipAddress        String?           @map("ip_address")
  userAgent        String?           @map("user_agent")
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamp(6)
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// Which chain network the website was on (its mainnet/testnet toggle) when this was created. Null = not said (older rows, webhooks).
  chainNetwork String? @map("chain_network")

  @@index([merchantId])
  @@index([reference])
  @@index([status])
  @@index([tokenType])
  @@index([accountNumber])
  @@index([createdAt])
  @@map("merchant_offramp_transactions")
}

/// Provider-specific details for an offramp (Bitnob payout order),
/// normalized out of the user/merchant offramp tables.
/// One structured reconciliation record per cash-out attempt (created at INITIATED, updated on every transition).
model OfframpReconciliation {
  id                   String   @id @default(uuid()) @db.Uuid
  /// Internal transaction id (offramp_transactions.id)
  offrampTransactionId String   @unique @map("offramp_transaction_id") @db.Uuid
  /// Our off_ reference
  reference            String   @unique
  /// Provider's order/payout id, when one exists
  externalReference    String?  @map("external_reference")
  /// Stellar transaction hash of the USDC deposit, when one exists
  stellarTxHash        String?  @map("stellar_tx_hash")
  asset                String   @default("USDC")
  /// Deposit amount the user was asked to send (asset units)
  amount               Decimal  @db.Decimal(20, 7)
  expectedSettlement   Decimal  @map("expected_settlement") @db.Decimal(20, 7)
  actualSettlement     Decimal  @default(0) @map("actual_settlement") @db.Decimal(20, 7)
  outstandingAmount    Decimal  @default(0) @map("outstanding_amount") @db.Decimal(20, 7)
  /// Off-ramp state (see offramp-state-machine.ts)
  status               String
  failureReason        String?  @map("failure_reason")
  failureDetail        Json?    @map("failure_detail")
  /// IN_PROGRESS | MATCHED | UNDERPAID | OVERPAID | PAYOUT_REJECTED | FUNDS_REVERSED | LIQUIDITY_SHORTFALL | TIMED_OUT | FAILED
  result               String   @default("IN_PROGRESS")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  settledAt            DateTime? @map("settled_at") @db.Timestamp(6)

  offrampTransaction   OfframpTransaction @relation(fields: [offrampTransactionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([result])
  @@index([createdAt])
  @@map("offramp_reconciliations")
}

/// A payout reversal linked to its original transaction. One per transaction => duplicate reversals are impossible.
model OfframpReversal {
  id                   String   @id @default(uuid()) @db.Uuid
  offrampTransactionId String   @unique @map("offramp_transaction_id") @db.Uuid
  /// Provider event that triggered the reversal (idempotency key)
  providerEventId      String?  @unique @map("provider_event_id")
  amount               Decimal  @db.Decimal(20, 7)
  reason               String?
  /// State the transaction was in when it was reversed (COMPLETED / PARTIALLY_SETTLED)
  originalStatus       String   @map("original_status")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  offrampTransaction   OfframpTransaction @relation(fields: [offrampTransactionId], references: [id], onDelete: Cascade)

  @@map("offramp_reversals")
}

/// Provider/settlement events already applied to a transaction. The unique eventKey makes event handling idempotent.
model OfframpEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  offrampTransactionId String   @map("offramp_transaction_id") @db.Uuid
  eventKey             String   @unique @map("event_key")
  type                 String
  payload              Json?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  offrampTransaction   OfframpTransaction @relation(fields: [offrampTransactionId], references: [id], onDelete: Cascade)

  @@index([offrampTransactionId])
  @@map("offramp_events")
}


model MerchantSwapTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  merchantId         String            @map("merchant_id") @db.Uuid
  reference          String            @unique
  fromTokenType      String            @map("from_token_type")
  fromAmount         Decimal           @map("from_amount") @db.Decimal(20, 8)
  fromNetwork        String?           @map("from_network")
  toTokenType        String            @map("to_token_type")
  toAmount           Decimal           @map("to_amount") @db.Decimal(20, 8)
  toNetwork          String?           @map("to_network")
  exchangeRate       Decimal           @map("exchange_rate") @db.Decimal(20, 8)
  sourceAddress      String            @map("source_address")
  destinationAddress String            @map("destination_address")
  status             TransactionStatus @default(PENDING)
  transactionHash    String?           @map("transaction_hash")
  feeAmount          Decimal?          @map("fee_amount") @db.Decimal(20, 8)
  feeCurrency        String?           @map("fee_currency")
  ipAddress          String?           @map("ip_address")
  userAgent          String?           @map("user_agent")
  metadata           Json?
