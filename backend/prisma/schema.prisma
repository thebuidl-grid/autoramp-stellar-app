enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
  REJECTED
  EXPIRED
  PARTIAL
  REVERSED
  // Off-ramp state machine (D1) — see src/modules/ramp/offramp-state-machine.ts
  INITIATED
  AWAITING_DEPOSIT
  DEPOSIT_DETECTED
  CONVERSION_PENDING
  PAYOUT_PENDING
  PARTIALLY_SETTLED
  INSUFFICIENT_LIQUIDITY
}

/// Parent row for every user transaction. The matching detail row (onramp_transactions, offramp_transactions, ...) has the SAME id.
/// Core facts only; provider specifics live on the legs (transaction_providers.details).
model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  type        TransactionKind
  /// Unique per type, not globally: a crypto-to-fiat swap and its fiat off-ramp share one reference (they are linked by relatedId).
  reference   String
  userId      String?           @map("user_id") @db.Uuid
  status      TransactionStatus @default(PENDING)
  /// Amount in `currency`, exactly as recorded on the detail row (copied by the backfill; not recomputed).
  amount      Decimal?          @db.Decimal(28, 8)
  currency    String?
  network     String?
  /// Request context: ipAddress, userAgent, transactionLocation, notifyUrl.
  context     Json?
  /// Off-ramp payout destination: bankCode, accountNumber, accountName, bankName.
  destination Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamp(6)
  /// The other half of a swap + off-ramp pair (swap <-> its fiat off-ramp). Null for everything else.
  relatedId   String?           @map("related_id") @db.Uuid

  @@unique([type, reference])
  @@index([reference])
  @@index([relatedId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

/// Same as Transaction, for merchant-initiated transactions (including VAS).
model MerchantTransaction {
  id          String            @id @default(uuid()) @db.Uuid
  type        TransactionKind
  reference   String
  merchantId  String            @map("merchant_id") @db.Uuid
  status      TransactionStatus @default(PENDING)
  amount      Decimal?          @db.Decimal(28, 8)
  currency    String?
  network     String?
  context     Json?
  destination Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamp(6)
  relatedId   String?           @map("related_id") @db.Uuid

  @@unique([type, reference])
  @@index([reference])
  @@index([relatedId])
  @@index([merchantId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("merchant_transactions")
}

/// One row per provider that touched a transaction (CCTP bridge, Bitnob payout, Safehaven deposit, ...).
/// `transactionId` points at transactions.id or merchant_transactions.id depending on `scope` (no DB foreign key).
model TransactionLeg {
  id                String       @id @default(uuid()) @db.Uuid
  transactionId     String       @map("transaction_id") @db.Uuid
  scope             LedgerScope  @default(USER)
  /// Copy of the transaction's reference, so webhooks and lookups find a leg without joining the parent tables.
  reference         String?
  role              LegRole
  provider          ProviderName
  /// The provider's own id for this leg: Bitnob order id, Flint id, CCTP burn/message hash, ...
  providerReference String?      @map("provider_reference")
  /// The provider's own status text for this leg.
  status            String?
  /// Provider-specific data that has no column of its own (deposit account, attestation, legacy provider name, ...).
  details           Json?
  /// What the payout provider expects the user to deposit, and what was actually received (partial settlement = received < expected).
  expectedAmount    Decimal?     @map("expected_amount") @db.Decimal(20, 7)
  receivedAmount    Decimal?     @map("received_amount") @db.Decimal(20, 7)
  /// expected - received when under-funded, else 0.
  outstandingAmount Decimal?     @map("outstanding_amount") @db.Decimal(20, 7)
  /// Where the user sends funds for this leg, with the required memo/tag, and when that window closes.
  fundingAddress    String?      @map("funding_address")
  memo              String?
  expiresAt         DateTime?    @map("expires_at") @db.Timestamp(6)
  /// On-chain hash of the funding deposit, and the user's source wallet.
  depositTxHash     String?      @map("deposit_tx_hash")
  sourceAddress     String?      @map("source_address")
  /// Receipt / narration the provider returned at settlement.
  paymentReference  String?      @map("payment_reference")
  /// Structured detail behind failureReason: rejection response, liquidity shortfall, timeout window, ...
  failureDetail     Json?        @map("failure_detail")
  lastEventAt       DateTime?    @map("last_event_at") @db.Timestamp(6)
  failedStep        String?      @map("failed_step")
  failureReason     String?      @map("failure_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([transactionId, role, provider])
  @@index([reference])
  @@index([provider, providerReference])
  @@index([transactionId])
  @@map("transaction_providers")
}

