{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compiler": "swc",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "assets": [
    {
      "include": "modules/analytics/allowed-emails.json",
      "outDir": "dist/modules/analytics",
      "watchAssets": true
    }
  ]
}
