{
  "name": "swapper-api-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "overrides": {
    "jayson": {
      "ws": {
        "utf-8-validate": "^5.0.2"
      }
    },
    "proxy-addr@<2.0.8": "^2.0.8",
    "socket.io-parser@<4.2.7": "^4.2.7",
    "engine.io@<6.6.10": "^6.6.10",
    "lodash@<4.18.1": "^4.18.1",
    "defu@<6.1.5": "^6.1.5",
    "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "zod@>=4.0.0 <4.6.6": "^4.6.6",
    "qs@<6.16.1": "^6.16.1"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "worker:webhook": "npx ts-node -r tsconfig-paths/register src/workers/webhook.worker.ts",
    "worker:audit": "npx ts-node -r tsconfig-paths/register src/workers/audit.worker.ts",
    "worker": "npx ts-node -r tsconfig-paths/register src/workers/webhook.worker.ts & npx ts-node -r tsconfig-paths/register src/workers/audit.worker.ts & wait"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.20.1",
    "@circle-fin/bridge-kit": "^1.17.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/passport-jwt": "^4.0.1",
    "axios": "1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "commander": "^14.0.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "raw-body": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
