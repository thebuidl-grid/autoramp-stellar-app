# Auth
JWT_SECRET=your_jwt_secret_here

# Email (Resend)
RESEND_API_KEY=resend_api_key_here
# Local dev only: when email delivery fails, return the OTP in the
# /auth/otp/send response instead of erroring. Never honored when
# NODE_ENV=production; leave unset anywhere real users can sign in.
# OTP_DEV_RETURN_CODE=true

# FX / Rates
MONIE_RATE_API_KEY=monie_rate_api_key_here

# Database
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Ramp processor selection — see modules/stablestack/ramp-processor.interface.ts.
# Recommended: 'safehaven' (AutoRamp is a signed SafeHaven partner — a
# licensed institution, not just a payments aggregator). 'paystack' is the
# Stellar-agnostic alternative; 'flint' is the original integration whose
# Stellar-compatible bank-rail-only behavior is unverified. The code
# fallback if this is left unset entirely is 'flint', for backward
# compatibility — set it explicitly.
RAMP_PROCESSOR_PROVIDER=safehaven

# Base URL the processor should call back to for per-transaction webhooks
# (Flint, Paystack aren't strict about this being reachable in dev; SafeHaven
# requires it — see below).
WEBHOOK_URL=https://your-api-domain.example.com/stablestack/webhook

# SafeHaven MFB — primary ramp processor (see
# modules/stablestack/providers/safehaven-ramp-processor.service.ts).
# SAFEHAVEN_CLIENT_ID is the OAuth Client ID from the SafeHaven dashboard;
# SAFEHAVEN_CLIENT_ASSERTION_PRIVATE_KEY is the RSA private key generated
# alongside it (PEM — literal "\n" line breaks are fine, they're unescaped
# at runtime). SAFEHAVEN_COMPANY_URL is the `iss` claim SafeHaven asked for
# when the app was created.
SAFEHAVEN_BASE_URL=https://api.sandbox.safehavenmfb.com
SAFEHAVEN_CLIENT_ID=your_oauth_client_id_here
SAFEHAVEN_CLIENT_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SAFEHAVEN_COMPANY_URL=https://your-company-url.example.com
# AutoRamp's own SafeHaven operating account: offramp payouts debit from
# here, and onramp virtual accounts settle into it once collected.
SAFEHAVEN_DEBIT_ACCOUNT_NUMBER=
SAFEHAVEN_SETTLEMENT_ACCOUNT_NUMBER=
SAFEHAVEN_SETTLEMENT_BANK_CODE=090286
SAFEHAVEN_VIRTUAL_ACCOUNT_VALID_FOR_SECONDS=1800
# Recommended: SafeHaven's webhook docs don't document a signature/HMAC
# scheme, so this shared secret is appended as `?key=` to the callback URL
# (onramp) — and should also be appended manually to whatever URL is
# registered in the SafeHaven dashboard for offramp payout notifications,
# since those have no per-request callback field at all.
SAFEHAVEN_WEBHOOK_SHARED_SECRET=

# StableStack (Flint) — bank-rail leg only, see modules/stablestack/providers/flint-ramp-processor.service.ts.
# Only needed if RAMP_PROCESSOR_PROVIDER=flint.
STABLESTACK_API_URL=http://localhost:1234
STABLESTACK_API_KEY=stablestack_api_key_here
# Required for Flint webhooks to be accepted at all (fail closed when unset).
# Register the callback URL with Flint as .../stablestack/webhook?key=<this>
# (or have Flint send it in an x-webhook-secret header).
FLINT_WEBHOOK_SECRET=

# Paystack — alternative ramp processor for NGN, Stellar-agnostic by design
# (see modules/stablestack/providers/paystack-ramp-processor.service.ts).
# Also the RampProcessor for the GH/GHS corridor (Paystack genuinely
# supports Ghana — dedicated virtual accounts + GhIPSS transfers). Needed
# whenever RAMP_PROCESSOR_PROVIDER=paystack OR a corridor's
# ramp_processor_provider is 'paystack' (e.g. the seeded GH/GHS corridor).
PAYSTACK_SECRET_KEY=sk_test_paystack_secret_key_here
# 'test-bank' only works with test-mode keys — production needs a real
# bank slug (e.g. 'wema-bank') from Paystack's Fetch Providers endpoint.
PAYSTACK_DVA_PREFERRED_BANK_NGN=test-bank
# No documented sandbox default for Ghana — required (not guessed) if any
# corridor routes GHS onramps through Paystack. Get the slug from
# Paystack's Fetch Providers endpoint for GHS.
PAYSTACK_DVA_PREFERRED_BANK_GHS=

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# AutoRamp's Stellar accounts (issuer mints CNGN; distribution sends/collects it)
STELLAR_ISSUER_SECRET=S...
STELLAR_DISTRIBUTION_SECRET=S...
STELLAR_DISTRIBUTION_PUBLIC_KEY=G...

# Asset issuers — CNGN_ISSUER_PUBLIC_KEY is AutoRamp's own issuing account
# (public key matching STELLAR_ISSUER_SECRET).
CNGN_ISSUER_PUBLIC_KEY=G...
#
# USDC_ISSUER_PUBLIC_KEY: Circle's Stellar USDC issuer. These are widely
# cited as the current values, but re-verify against Circle's live docs
# before using in production — an issuer mismatch here sends/reads the
# wrong asset entirely:
#   mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
#   testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ISSUER_PUBLIC_KEY=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#
# BRIDGE_USDC_ISSUER_PUBLIC_KEY: same Circle USDC issuer as above, kept as a
# SEPARATE var deliberately — powers the XLM<->USDC swap route (real,
# CCTP-bridge-compatible USDC) independently of whatever USDC_ISSUER_PUBLIC_KEY
# is set to for the NGN on/offramp corridor (which may be a different,
# self-issued stand-in in some environments). Same mainnet/testnet values:
#   mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
#   testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
BRIDGE_USDC_ISSUER_PUBLIC_KEY=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# USDC cross-chain bridge infra (Phase 1: inbound CCTP -> Stellar; see
# modules/bridge/). Soroban RPC is a separate endpoint from Horizon —
# STELLAR_HORIZON_URL above does not serve Soroban RPC calls. Unlike
# testnet (SDF runs the free public endpoint below), there's no single
# canonical free SDF-hosted mainnet RPC — pick a provider (Blockdaemon,
# QuickNode, etc.) before actually going live.
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deliberately a separate key from STELLAR_DISTRIBUTION_SECRET — this
# relays Soroban CCTP mints, newer/less-proven code than the rest of the
# app; a bug here shouldn't be able to touch fiat corridor payout funds.
STELLAR_BRIDGE_RELAYER_SECRET=S...
# Circle's attestation service. Leave unset to auto-select sandbox/mainnet
# based on STELLAR_NETWORK.
CIRCLE_IRIS_API_URL=https://iris-api-sandbox.circle.com

# EVM side of the bridge (modules/bridge/providers/evm-relayer.service.ts).
# RPC URLs are public/free and fine for dev; a production deployment should
# use a dedicated provider (Alchemy/Infura/etc) instead — public endpoints
# are rate-limited and not reliable enough once real traffic hits them.
# Relayer keys submit destination-chain mints only (permissionless once
# Circle attests, so this key is never holding user funds mid-transfer —
# see StellarService vs this key's blast-radius separation), but it still
# pays real gas and must be funded on whichever network it targets.
#   testnet (current default below): Base Sepolia / Ethereum Sepolia / ...
#   mainnet: BASE_RPC_URL=https://mainnet.base.org
#            ETHEREUM_RPC_URL=<a dedicated provider, not a public endpoint>
#            ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
#            OPTIMISM_RPC_URL=https://mainnet.optimism.io
#            POLYGON_RPC_URL=https://polygon-rpc.com
#            AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Chain registry contract addresses for both networks are already wired in
# prisma/seed.ts, toggled by the same STELLAR_NETWORK flag as everything
# else — re-run `npm run seed` after switching networks.
BASE_RPC_URL=https://sepolia.base.org
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://sepolia.optimism.io
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BASE_RELAYER_PRIVATE_KEY=
ETHEREUM_RELAYER_PRIVATE_KEY=
ARBITRUM_RELAYER_PRIVATE_KEY=
OPTIMISM_RELAYER_PRIVATE_KEY=
POLYGON_RELAYER_PRIVATE_KEY=
AVALANCHE_RELAYER_PRIVATE_KEY=

# Multi-stablecoin bridge-in (Swap tab): converts a non-USDC source token
# (USDT, DAI, ...) to USDC on the EVM source chain before the CCTP burn.
# Get a key at https://dashboard.0x.org. Leave blank to disable — plain
# USDC bridging/swapping is unaffected either way.
ZEROX_API_KEY=
