{
  "openapi": "3.0.0",
  "paths": {
    "/swap/quote": {
      "get": {
        "operationId": "SwapController_getQuote",
        "parameters": [
          {
            "name": "fromToken",
            "required": true,
            "in": "query",
            "schema": {
              "enum": [
                "USDC",
                "CNGN"
              ],
              "type": "string"
            }
          },
          {
            "name": "toToken",
            "required": true,
            "in": "query",
            "schema": {
              "enum": [
                "USDC",
                "CNGN"
              ],
              "type": "string"
            }
          },
          {
            "name": "amount",
            "required": true,
            "in": "query",
            "description": "Amount of fromToken to swap",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote with source/destination amounts and exchange rate"
          }
        },
        "summary": "Get a live swap quote between USDC and CNGN",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/balance/{token}/{address}": {
      "get": {
        "operationId": "SwapController_getTokenBalance",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "Token symbol (e.g., USDC, CNGN)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "required": true,
            "in": "path",
            "description": "Stellar public key (G...)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token balance as string"
          }
        },
        "summary": "Get token balance for an address",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/trustline/{token}/{address}": {
      "get": {
        "operationId": "SwapController_hasTrustline",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "Token symbol (e.g., USDC, CNGN)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "required": true,
            "in": "path",
            "description": "Stellar public key (G...)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whether the trustline exists"
          }
        },
        "summary": "Check whether an address has a trustline for a token",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/trustline/{token}/{address}/sponsor": {
      "post": {
        "description": "Builds a transaction (partially signed by AutoRamp's distribution account) that creates a trustline for the given token, with AutoRamp sponsoring the reserve. The user's wallet must sign and submit it. Requires authentication.",
        "operationId": "SwapController_getSponsoredTrustline",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "Token symbol (e.g., USDC, CNGN)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "required": true,
            "in": "path",
            "description": "Stellar public key (G...) that will hold the trustline; must already exist on-chain",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Unsigned (by the user) transaction XDR + network passphrase"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Get a sponsored trustline transaction to sign",
        "tags": [
          "Swap"
        ]
      }
    },
    "/swap/balances": {
      "get": {
        "operationId": "SwapController_getTokenBalances",
        "parameters": [
          {
            "name": "address",
            "required": true,
            "in": "query",
            "description": "Stellar public key (G...)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record of balances"
          }
        },
        "summary": "Get balances for USDC and CNGN for an address",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/usd-ngn-rate": {
      "get": {
        "operationId": "SwapController_getUsdNgnRate",
        "parameters": [],
        "responses": {
          "200": {
            "description": "USD/NGN rate"
          }
        },
        "summary": "Get USD/NGN rate from MonieRate API",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/estimate-ngn": {
      "get": {
        "operationId": "SwapController_estimateNgn",
        "parameters": [
          {
            "name": "cngnAmount",
            "required": true,
            "in": "query",
            "description": "Amount in CNGN",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estimated NGN value with rates"
          }
        },
        "summary": "Calculate estimated NGN value from CNGN amount",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/swap/initialize": {
      "post": {
        "description": "Initializes offramp first to get recipient wallet address, then creates swap record. Returns recipient address and swap parameters for frontend to execute the swap. Requires authentication.",
        "operationId": "SwapController_initializeSwap",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitializeSwapDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swap and offramp initialization response with recipient address"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing authentication"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Initialize swap transaction (USDC → CNGN → Offramp)",
        "tags": [
          "Swap"
        ]
      }
    },
    "/swap/{reference}/complete": {
      "post": {
        "description": "Updates swap transaction status after user executes the swap on blockchain. Requires authentication.",
        "operationId": "SwapController_updateSwapAfterExecution",
        "parameters": [
          {
            "name": "reference",
            "required": true,
            "in": "path",
            "description": "Swap transaction reference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transactionHash": {
                    "type": "string",
                    "example": "0x..."
                  },
                  "sourceAddress": {
                    "type": "string",
                    "example": "0x..."
                  }
                },
                "required": [
                  "transactionHash",
                  "sourceAddress"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swap transaction updated successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Update swap transaction after execution",
        "tags": [
          "Swap"
        ]
      }
    },
    "/swap/create": {
      "post": {
        "description": "Creates a swap transaction record in the database. The actual swap execution happens on-chain via the frontend. Requires authentication.",
        "operationId": "SwapController_createSimpleSwap",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSimpleSwapDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swap transaction created successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Create a simple swap transaction (store in database)",
        "tags": [
          "Swap"
        ]
      }
    },
    "/stablestack/banks": {
      "get": {
        "operationId": "StablestackController_getBanks",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of banks"
          }
        },
        "summary": "Get list of banks",
        "tags": [
          "Stablestack"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    },
    "/stablestack/resolve-account": {
      "get": {
        "description": "Resolves account name from bank code and account number. Requires authentication (JWT token in Authorization header or API key in x-api-key header).",
        "operationId": "StablestackController_resolveAccount",
        "parameters": [
          {
            "name": "bankCode",
            "required": true,
            "in": "query",
            "description": "Bank code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountNumber",
            "required": true,
            "in": "query",
            "description": "Account number",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account name resolved successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Resolve account name",
        "tags": [
          "Stablestack"
        ]
      }
    },
    "/stablestack/onramp": {
      "post": {
        "description": "Requires authentication (JWT token in Authorization header or API key in x-api-key header)",
        "operationId": "StablestackController_onRamp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/onRampDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Onramp Initialisation response"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Initialise onramp transaction",
        "tags": [
          "Stablestack"
        ]
      }
    },
    "/stablestack/offramp": {
      "post": {
        "description": "Requires authentication (JWT token in Authorization header or API key in x-api-key header)",
        "operationId": "StablestackController_offRamp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/offRampDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Offramp Initialisation response"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Initialise offramp transaction",
        "tags": [
          "Stablestack"
        ]
      }
    },
    "/stablestack/offramp/{reference}/confirm-deposit": {
      "post": {
        "description": "Reports the Stellar transaction hash of a CNGN deposit sent to the offramp collection account. Verifies it on-chain via Horizon before moving the transaction out of PENDING.",
        "operationId": "StablestackController_confirmOfframpDeposit",
        "parameters": [
          {
            "name": "reference",
            "required": true,
            "in": "path",
            "description": "Offramp transaction reference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transactionHash": {
                    "type": "string"
                  }
                },
                "required": [
                  "transactionHash"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deposit confirmed, transaction moved to PROCESSING"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Confirm a CNGN deposit for an offramp transaction",
        "tags": [
          "Stablestack"
        ]
      }
    },
    "/stablestack/transactions": {
      "get": {
        "description": "Requires authentication (JWT token in Authorization header or API key in x-api-key header) and verified KYC status. Returns transactions for the authenticated user.",
        "operationId": "StablestackController_getTransactions",
        "parameters": [
          {
            "name": "id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reference",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (default: 1)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page (default: 10)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "API-Key": []
          }
        ],
        "summary": "Get ramp transactions",
        "tags": [
          "Stablestack"
        ]
      }
    },
    "/stablestack/webhook": {
      "post": {
        "operationId": "WebhookController_handleWebhook",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook processed successfully"
          },
          "404": {
            "description": "Transaction not found"
          }
        },
        "summary": "Receive webhook from Flint API",
        "tags": [
          "Stablestack"
        ],
        "security": [
          {
            "API-Key": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "CNGN Ramp Business API",
    "description": "Programmatic API for businesses to perform onramp, offramp, and swap operations.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "API-Key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Your business API key generated from the admin portal."
      }
    },
    "schemas": {
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "otpCode": {
            "type": "string",
            "example": "123456",
            "description": "6-digit OTP code for email verification"
          },
          "walletAddress": {
            "type": "string",
            "example": "GDQP2KPQGKIHYJGXNUIYOMHARUARCA7DJT5FO2FFOOKY3B2WSQHG4W37",
            "description": "User wallet address (optional)"
          }
        },
        "required": [
          "email",
          "otpCode"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "SecurePassword123!",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com",
            "description": "Admin email address"
          },
          "password": {
            "type": "string",
            "example": "AdminPassword123!",
            "description": "Admin password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SendOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email address to send OTP to"
          },
          "purpose": {
            "type": "string",
            "example": "SIGNUP",
            "description": "Purpose of OTP (SIGNUP, RESET_PASSWORD, etc.)",
            "default": "SIGNUP"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email address"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit OTP code"
          },
          "purpose": {
            "type": "string",
            "example": "SIGNUP",
            "description": "Purpose of OTP (SIGNUP, RESET_PASSWORD, etc.)",
            "default": "SIGNUP"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Production API Key",
            "description": "Optional name for the API key (for identification)",
            "maxLength": 100
          },
          "businessName": {
            "type": "string",
            "description": "Business name associated with this API key"
          },
          "trafficEstimate": {
            "type": "string",
            "description": "Expected traffic/volume for this API key"
          },
          "requestLimit": {
            "type": "string",
            "description": "Request limit for this API key"
          }
        }
      },
      "CreateMerchantDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "merchant@example.com",
            "description": "Email address of the merchant"
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Name of the contact person"
          },
          "businessName": {
            "type": "string",
            "example": "Acme Corp",
            "description": "Business name"
          },
          "websiteUrl": {
            "type": "string",
            "example": "https://acme.com",
            "description": "Business website URL"
          },
          "trafficEstimate": {
            "type": "string",
            "description": "Expected traffic/volume for this API key"
          },
          "requestLimit": {
            "type": "string",
            "description": "Request limit for this API key"
          }
        },
        "required": [
          "email",
          "name",
          "businessName",
          "websiteUrl"
        ]
      },
      "TransactionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Transaction ID"
          },
          "userId": {
            "type": "string",
            "description": "User ID"
          },
          "reference": {
            "type": "string",
            "description": "Transaction Reference"
          },
          "status": {
            "type": "string",
            "description": "Transaction Status"
          },
          "transactionType": {
            "type": "string",
            "description": "Transaction Type",
            "enum": [
              "onramp",
              "offramp",
              "swap"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation Timestamp"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Last Update Timestamp"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Completion Timestamp"
          },
          "amount": {
            "type": "number",
            "description": "On-ramp amount in NGN"
          },
          "tokenAmount": {
            "type": "number",
            "description": "On-ramp token amount in CNGN"
          },
          "destinationAddress": {
            "type": "string",
            "description": "Destination address for on-ramp"
          },
          "amount_offramp": {
            "type": "number",
            "description": "Off-ramp amount in token"
          },
          "fiatAmount": {
            "type": "number",
            "description": "Off-ramp fiat amount in NGN"
          },
          "bankCode": {
            "type": "string",
            "description": "Bank code for off-ramp"
          },
          "accountNumber": {
            "type": "string",
            "description": "Account number for off-ramp"
          },
          "fromTokenType": {
            "type": "string",
            "description": "From token type for swap"
          },
          "fromAmount": {
            "type": "number",
            "description": "From amount for swap"
          },
          "toTokenType": {
            "type": "string",
            "description": "To token type for swap"
          },
          "toAmount": {
            "type": "number",
            "description": "To amount for swap"
          },
          "sourceAddress": {
            "type": "string",
            "description": "Source address for swap"
          },
          "destinationAddress_swap": {
            "type": "string",
            "description": "Destination address for swap"
          }
        },
        "required": [
          "id",
          "userId",
          "reference",
          "status",
          "transactionType",
          "createdAt",
          "updatedAt"
        ]
      },
      "SummaryStats": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "totalAmount": {
            "type": "number"
          }
        },
        "required": [
          "count",
          "totalAmount"
        ]
      },
      "TransactionSummaryDto": {
        "type": "object",
        "properties": {
          "onRamps": {
            "$ref": "#/components/schemas/SummaryStats"
          },
          "offRamps": {
            "$ref": "#/components/schemas/SummaryStats"
          },
          "swaps": {
            "$ref": "#/components/schemas/SummaryStats"
          }
        },
        "required": [
          "onRamps",
          "offRamps",
          "swaps"
        ]
      },
      "OfframpDestinationDto": {
        "type": "object",
        "properties": {
          "bankCode": {
            "type": "string",
            "example": "058",
            "description": "Bank code"
          },
          "accountNumber": {
            "type": "string",
            "example": "1234567890",
            "description": "Account number"
          }
        },
        "required": [
          "bankCode",
          "accountNumber"
        ]
      },
      "InitializeSwapDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "example": 140196,
            "description": "NGN amount for offramp (estimated NGN value)"
          },
          "usdcAmount": {
            "type": "number",
